{
  "rules": {
    ".read": false,
    ".write": false,
    "quizzes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "games": {
      "$pin": {
        ".read": true,
        ".write": true
      }
    }
  }
}
